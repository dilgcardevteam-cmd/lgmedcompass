APP_NAME="LGMed Compass"
APP_ENV=production
APP_KEY= # Leave empty – run `php artisan key:generate` on the server after deployment
APP_DEBUG=false
APP_URL=https://yourdomain.com          # ← Your actual domain (with HTTPS)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Keep your API key (ensure it's the production key, not a test key)
CALENDARIFIC_API_KEY=ILNsm6Ijex6Mb28Obc6LlnXUmU8PCuvV

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database   # Commented – default is 'database' anyway

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug   # Optional: change to 'error' in production for less noise

# ========== DATABASE (Hostinger MySQL) ==========
DB_CONNECTION=mysql
DB_HOST=localhost          # Usually 'localhost' on Hostinger shared hosting
DB_PORT=3306
DB_DATABASE=your_hostinger_db_name     # ← Create this in hPanel
DB_USERNAME=your_hostinger_db_user     # ← Create this in hPanel
DB_PASSWORD=your_hostinger_db_password # ← The password you set

# ========== SESSION & CACHE (using database) ==========
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database   # For notifications/queues – requires cron job

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ========== MAIL (Hostinger SMTP – DO NOT use Gmail in production) ==========
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com          # Hostinger's SMTP server
MAIL_PORT=465                         # or 587 with TLS
MAIL_USERNAME=your-email@yourdomain.com   # Your Hostinger email address
MAIL_PASSWORD=your_hostinger_email_password  # The email account's password
MAIL_FROM_ADDRESS="noreply@yourdomain.com"  # Sender address
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=ssl                   # Use 'tls' if port 587

# ========== AWS (if unused, keep empty) ==========
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ========== VITE ==========
VITE_APP_NAME="${APP_NAME}"